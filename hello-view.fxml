<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane prefHeight="400.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.appcontroller.AppController">

    <children>
        <ListView fx:id="list"
                  layoutX="45.0" layoutY="43.0"
                  prefHeight="200.0" prefWidth="200.0" />

        <TextField fx:id="name"
                   layoutX="45.0" layoutY="256.0" />

        <Button fx:id="btn1"
                layoutX="45.0" layoutY="296.0"
                mnemonicParsing="false"
                onAction="#add" text="Add" />

        <Button fx:id="btn2"
                layoutX="109.0" layoutY="296.0"
                mnemonicParsing="false"
                onAction="#removed" text="Remove" />

        <Button fx:id="btn3"
                layoutX="175.0" layoutY="296.0"
                mnemonicParsing="false"
                onAction="#update" text="Update" />
    </children>
</Pane>
