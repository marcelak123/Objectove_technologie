<<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>


<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.facktury.HelloController"
            prefWidth="900"
            prefHeight="500">

<center>
    <HBox spacing="10"
          style="-fx-padding: 10;">

        <TableView fx:id="invoiceTable"
                   prefWidth="400"
                   HBox.hgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="invoiceId"
                             text="ID"
                             prefWidth="55"/>

                <TableColumn fx:id="invoiceDate"
                             text="Dátum"
                             prefWidth="125"/>

                <TableColumn fx:id="invoiceStatus"
                             text="Stav"
                             prefWidth="175"/>
            </columns>

        </TableView>

        <TableView fx:id="itemTable"
                   prefWidth="480"
                   HBox.hgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="itemName"
                             text="Produkt"
                             prefWidth="170"/>

                <TableColumn fx:id="itemAmount"
                             text="Počet"
                             prefWidth="65"/>

                <TableColumn fx:id="itemPrice"
                             text="Cena"
                             prefWidth="95"/>

                <TableColumn fx:id="itemTotal"
                             text="Spolu"
                             prefWidth="95"/>
            </columns>

        </TableView>

    </HBox>
</center>

<bottom>
    <HBox alignment="CENTER_RIGHT"
          style="-fx-padding: 15;
                     -fx-background-color: #eeeeee;">

        <Label fx:id="totalLabel"
               text="Celková suma: 0.00 €"
               style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

    </HBox>
</bottom>

</BorderPane>

