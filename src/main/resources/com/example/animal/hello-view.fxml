<?import javafx.scene.layout.Pane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.animal.HelloController">

    <top>
        <HBox spacing="8">
            <Button fx:id="btn1" text="Carnivore"/>
            <Button fx:id="btn2" text="Herbivore"/>
            <Button fx:id="btn3" text="Novy smer-C"/>
            <Button fx:id="btn4" text="Stoj/Chod-H"/>
        </HBox>
    </top>

    <center>
        <Pane fx:id="plocha"
              prefWidth="800"
              prefHeight="500"
              minWidth="800"
              minHeight="500"/>
    </center>

</BorderPane>
